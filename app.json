{
  "expo": {
    "name": "velora_ai",
    "slug": "velora_ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": ["velora", "appwrite-callback-67e5951f000a9b52f73a"],
    "userInterfaceStyle": "automatic",
    "jsEngine": "hermes",
    "ios": {
      "bundleIdentifier": "com.redshanks.velora-ai",
      "supportsTablet": true,
      "newArchEnabled": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "We need access to your photos so you can select images.",
        "NSPhotoLibraryAddUsageDescription": "We need permission to save edited images to your photo library.",
        "NSMicrophoneUsageDescription": "We need access to your mic for voice input.",
        "NSSpeechRecognitionUsageDescription": "We need access to recognize your speech.",
        "NSBonjourServiceTypes": ["_http._tcp"],
        "LSApplicationQueriesSchemes": ["googlechrome", "instagram", "fb"],
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["velora"],
            "CFBundleURLName": "com.redshanks.velora-ai"
          }
        ]
      }
    },
    "android": {
      "package": "com.redshanks.veloraai",
      "newArchEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#ffffff"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "*.velora.com"
            },
            {
              "scheme": "velora"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your friends."
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone.",
          "disableAudioDefaults": true
        }
      ],
      ["@wdragon/react-native-voice"],
      "expo-dev-client"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "7db25f7b-4103-4546-a636-cb4e9a8c56f2"
      }
    }
  }
}
